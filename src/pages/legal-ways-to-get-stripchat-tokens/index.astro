    '@type': 'Article',
    headline: 'Legal Ways to Get Stripchat Tokens: A Complete Guide',
    description,
    inLanguage: 'en',
    mainEntityOfPage: canonicalUrl(path),
    dateModified: CONTENT_REVIEWED_ISO,
    author: { '@type': 'Organization', name: 'Stripchat Tokens Guide' },
    publisher: { '@type': 'Organization', name: 'Stripchat Tokens Guide' },
