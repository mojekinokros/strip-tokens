---
import { withBase } from '../lib/site';

interface Props {
  current: string;
}

const { current } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  <div class="container">
    <ol>
      <li><a href={withBase('')}>Home</a></li>
      <li><span aria-current="page">{current}</span></li>
    </ol>
  </div>
</nav>
